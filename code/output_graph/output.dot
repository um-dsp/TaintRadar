digraph "&lt;global&gt;" {  
"330" [label = <(METHOD,&lt;global&gt;)> ]
"331" [label = <(BLOCK,&lt;empty&gt;,&lt;empty&gt;)> ]
"332" [label = <(&lt;operator&gt;.assignment,$name = $_GET[&quot;name&quot;])<SUB>2</SUB>> ]
"323" [label = <(IDENTIFIER,$name,$name = $_GET[&quot;name&quot;])<SUB>2</SUB>> ]
"333" [label = <(&lt;operator&gt;.indexAccess,$_GET[&quot;name&quot;])<SUB>2</SUB>> ]
"325" [label = <(IDENTIFIER,$_GET,$name = $_GET[&quot;name&quot;])<SUB>2</SUB>> ]
"334" [label = <(LITERAL,&quot;name&quot;,$name = $_GET[&quot;name&quot;])<SUB>2</SUB>> ]
"335" [label = <(echo,echo &quot;Hello &quot; . $name)<SUB>3</SUB>> ]
"336" [label = <(&lt;operator&gt;.concat,&quot;Hello &quot; . $name)<SUB>3</SUB>> ]
"337" [label = <(LITERAL,&quot;Hello &quot;,&quot;Hello &quot; . $name)<SUB>3</SUB>> ]
"327" [label = <(IDENTIFIER,$name,&quot;Hello &quot; . $name)<SUB>3</SUB>> ]
"338" [label = <(METHOD_RETURN,&lt;empty&gt;)> ]
  "330" -> "331" 
  "330" -> "338" 
  "331" -> "332" 
  "331" -> "335" 
  "332" -> "323" 
  "332" -> "333" 
  "333" -> "325" 
  "333" -> "334" 
  "335" -> "336" 
  "336" -> "337" 
  "336" -> "327" 
}
