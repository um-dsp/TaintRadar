digraph "&lt;global&gt;" {  
"394" [label = <(METHOD,&lt;global&gt;)> ]
"395" [label = <(BLOCK,&lt;empty&gt;,&lt;empty&gt;)> ]
"396" [label = <(&lt;operator&gt;.assignment,$name = $_GET[&quot;name&quot;])<SUB>2</SUB>> ]
"387" [label = <(IDENTIFIER,$name,$name = $_GET[&quot;name&quot;])<SUB>2</SUB>> ]
"397" [label = <(&lt;operator&gt;.indexAccess,$_GET[&quot;name&quot;])<SUB>2</SUB>> ]
"389" [label = <(IDENTIFIER,$_GET,$name = $_GET[&quot;name&quot;])<SUB>2</SUB>> ]
"398" [label = <(LITERAL,&quot;name&quot;,$name = $_GET[&quot;name&quot;])<SUB>2</SUB>> ]
"399" [label = <(echo,echo &quot;Hello &quot; . $name)<SUB>3</SUB>> ]
"400" [label = <(&lt;operator&gt;.concat,&quot;Hello &quot; . $name)<SUB>3</SUB>> ]
"401" [label = <(LITERAL,&quot;Hello &quot;,&quot;Hello &quot; . $name)<SUB>3</SUB>> ]
"391" [label = <(IDENTIFIER,$name,&quot;Hello &quot; . $name)<SUB>3</SUB>> ]
"402" [label = <(METHOD_RETURN,&lt;empty&gt;)> ]
  "394" -> "395" 
  "394" -> "402" 
  "395" -> "396" 
  "395" -> "399" 
  "396" -> "387" 
  "396" -> "397" 
  "397" -> "389" 
  "397" -> "398" 
  "399" -> "400" 
  "400" -> "401" 
  "400" -> "391" 
}
